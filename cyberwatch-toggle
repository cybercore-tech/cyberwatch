#!/usr/bin/env bash
# Launches Cyberwatch in a floating terminal, or — with `--summary` — just
# resolves the binary and runs its `--summary` mode for the bar widget's
# periodic poll (no terminal, no window), or — with `--web` — opens/focuses
# DaemonHall (falling back to the terminal). Same bootstrap as cyberfleet's
# own toggle script.
#
# Deliberately does NOT fetch or execute a remote build artifact — no
# download-then-chmod-then-run of a release asset, and no
# `cargo install --git <remote>`. Instead:
#   1. use the bundled bin/<arch>/cyberwatch shipped in this checkout, or
#   2. build THIS checkout's own already-cloned source with `cargo build
#      --locked` (no new code fetched), caching the result for next time, or
#   3. tell the user how to get a binary themselves.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WINDOW_TITLE="Cyberwatch"
BIN_DIR=""
CYBERWATCH_BIN=""

arch_dir() {
  case "$(uname -m)" in
    x86_64 | amd64) echo "linux-x86_64" ;;
    aarch64 | arm64) echo "linux-aarch64" ;;
    *) echo "linux-$(uname -m)" ;;
  esac
}

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Cyberwatch" "$1" || true
  fi
  echo "cyberwatch-toggle: $1" >&2
}

resolve_bin() {
  BIN_DIR="$PLUGIN_DIR/bin/$(arch_dir)"
  CYBERWATCH_BIN="$BIN_DIR/cyberwatch"
}

build_from_local_source() {
  command -v cargo >/dev/null 2>&1 || return 1
  [[ -f "$PLUGIN_DIR/Cargo.toml" && -f "$PLUGIN_DIR/Cargo.lock" ]] || return 1
  mkdir -p "$BIN_DIR"
  notify "Building cyberwatch for $(arch_dir) (first run)…"
  local build_dir="$PLUGIN_DIR/.cargo-build"
  rm -rf "$build_dir"
  if ! CARGO_TARGET_DIR="$build_dir" cargo build --release --locked \
    --manifest-path "$PLUGIN_DIR/Cargo.toml"; then
    rm -rf "$build_dir"
    return 1
  fi
  cp "$build_dir/release/cyberwatch" "$CYBERWATCH_BIN"
  chmod +x "$CYBERWATCH_BIN"
  rm -rf "$build_dir"
}

ensure_binary() {
  resolve_bin
  if [[ -x "$CYBERWATCH_BIN" ]]; then
    return 0
  fi

  if build_from_local_source; then
    return 0
  fi

  notify "No cyberwatch binary for $(arch_dir) and no cargo available to build one. \
Install Rust (https://rustup.rs), or build it yourself from \
~/.sysops/cyberwatch and place it at: $CYBERWATCH_BIN"
  return 1
}

focus_existing() {
  hyprctl dispatch focuswindow "title:^(${WINDOW_TITLE})$" 2>/dev/null | grep -q ok
}

launch() {
  local terminal="${TERMINAL:-}"
  if [[ -z "$terminal" ]]; then
    for candidate in ghostty alacritty kitty foot; do
      if command -v "$candidate" >/dev/null 2>&1; then
        terminal="$candidate"
        break
      fi
    done
  fi

  case "$terminal" in
    alacritty)
      exec setsid uwsm-app -- alacritty --class "$WINDOW_TITLE" --title "$WINDOW_TITLE" -e "$CYBERWATCH_BIN"
      ;;
    kitty)
      exec setsid uwsm-app -- kitty --class "$WINDOW_TITLE" --title "$WINDOW_TITLE" "$CYBERWATCH_BIN"
      ;;
    ghostty)
      exec setsid uwsm-app -- ghostty --title="$WINDOW_TITLE" -e "$CYBERWATCH_BIN"
      ;;
    foot)
      exec setsid uwsm-app -- foot --title="$WINDOW_TITLE" "$CYBERWATCH_BIN"
      ;;
    *)
      exec setsid uwsm-app -- xdg-terminal-exec --title="$WINDOW_TITLE" -e "$CYBERWATCH_BIN"
      ;;
  esac
}

# --web: open DaemonHall (the web dashboard over the same watch list) as its
# own app window, or focus it if one is already open. Falls back to the TUI
# when DaemonHall isn't running.
open_daemonhall() {
  # localhost, not 127.0.0.1: a different host gives the app window its own
  # class (brave-localhost__-Default), so it isn't caught by window rules
  # written for other 127.0.0.1 web apps (e.g. a Cyberdeck scratchpad rule).
  local url="http://localhost:${DAEMONHALL_PORT:-8767}/"
  if command -v curl >/dev/null 2>&1 && curl -fsS -m 1 -o /dev/null "$url"; then
    # Focus an open DaemonHall app window: its title is exactly the page title,
    # "DAEMONHALL" or "(N) DAEMONHALL". Matched case-sensitively and whole, so
    # a Files window or terminal that's merely in a "DaemonHall" folder isn't
    # mistaken for it (omarchy-launch-or-focus matches case-insensitively).
    local addr=""
    if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      addr="$(hyprctl clients -j | jq -r '.[] | select(.title | test("^(\\([0-9]+\\) )?DAEMONHALL$")) | .address' | head -n1)"
    fi
    if [[ -n "$addr" ]]; then
      # Lua-config Hyprland takes hl.dsp.*; older versions take focuswindow
      # (same fallback as omarchy-launch-or-focus).
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 ||
        hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
      exit 0
    fi
    if command -v omarchy-launch-webapp >/dev/null 2>&1; then
      exec setsid omarchy-launch-webapp "$url"
    fi
    exec setsid xdg-open "$url"
  fi
  notify "DaemonHall isn't running on $url, opening the TUI instead."
}

if [[ "${1:-}" == "--web" ]]; then
  open_daemonhall
fi

ensure_binary || exit 1

if [[ "${1:-}" == "--summary" ]]; then
  exec "$CYBERWATCH_BIN" --summary
fi

if focus_existing; then
  exit 0
fi

launch
